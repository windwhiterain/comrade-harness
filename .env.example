# LLM 配置（brain core 的 agent loop 使用，Bun 会自动加载 .env）
# 留空则用环境变量 DEEPSEEK_API_KEY
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 局域网访问：暴露给浏览器/壳/core 页面的 URL 用哪个 host。
# 留空 = 自动探测本机局域网 IPv4；需要固定时显式指定（如 PUBLIC_HOST=192.168.2.254）
PUBLIC_HOST=

# 可选控制面令牌：设置后 daemon 的 /api/* 与 /ws、core 的 /api/* 都要求
# Authorization: Bearer <token>（或 URL ?token=）。壳和对话 UI 会在 401 时提示输入。
# 不设则完全开放——只应在可信网络（本机/家庭网）里这么用。
COCKPIT_TOKEN=
